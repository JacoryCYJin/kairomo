{
  "name": "kairomo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "vue-tsc --noEmit && eslint . && node scripts/check-architecture.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "format": "prettier --write src scripts docs *.json *.ts *.js *.md .github/workflows/*.yml",
    "format:check": "prettier --check src scripts docs *.json *.ts *.js *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-vue-next": "^0.468.0",
    "matter-js": "^0.20.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/matter-js": "^0.20.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
