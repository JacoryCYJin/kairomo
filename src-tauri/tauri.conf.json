{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairomo Dev",
  "version": "0.1.0-beta.2",
  "identifier": "com.jacorycyjin.kairomo.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairomo Dev",
        "width": 360,
        "height": 280,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "details",
        "title": "Kairomo Dev",
        "url": "index.html?view=settings",
        "width": 620,
        "height": 640,
        "minWidth": 520,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Time for what matters.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NzRBRDYxN0RCRDk2OUUKUldTZWxyMTlZYTEweEJjWlVQa0JrWExtaTI0cG8rMm80aTYyR3FoajV3N2FYdlNvNnFNWGllaS8K",
      "requireSignedVersion": true
    }
  }
}
